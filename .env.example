# Cloudflare Turnstile (newsletter form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notion blog. Create an internal integration at notion.so/profile/integrations,
# then share the Blog database with it (database menu -> Connections).
NOTION_TOKEN=
# Optional: defaults to the Blog database under "Merlin Leadership".
NOTION_DATABASE_ID=

# Resend (welcome email). Use a key with "Sending access" only.
RESEND_API_KEY=
# Shown in email footers (required by Canada's anti-spam law). Kept out of the
# public repo on purpose.
MAILING_ADDRESS=

# Optional: Cloudflare Web Analytics beacon token (Cloudflare dashboard ->
# Analytics & Logs -> Web Analytics -> your site -> JS snippet). Public value.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
